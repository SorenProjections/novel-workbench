# 真实生成配置。无密钥体验请运行 python scripts/demo.py。
# 普通工作台也可在“模型与 API”保存并启用配置；启用后优先于以下模型配置。
# NOVELWB_MODEL_SETTINGS_DISABLED=1 可强制使用环境配置（离线演示会自动设置）。
# 不要在此文件填写真实密钥；复制为 .env 后编辑。
DEEPSEEK_API_KEY=
# 以下模型值沿用当前适配器默认配置；真实调用前核对自己的可用模型。
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_GRAPH2_TIMEOUT=300
DEEPSEEK_GRAPH2_RETRIES=1
DEEPSEEK_GRAPH3_TIMEOUT=600
DEEPSEEK_GRAPH3_RETRIES=1
DEEPSEEK_GRAPH4_PLAN_TIMEOUT=300
DEEPSEEK_GRAPH4_PLAN_RETRIES=1
DEEPSEEK_BLOCKS_TIMEOUT=180
DEEPSEEK_BLOCKS_RETRIES=1
DEEPSEEK_GRAPHE_TIMEOUT=180
DEEPSEEK_GRAPHE_RETRIES=0
# 事件上下文是确定性裁剪，不做模型摘要；适用于长上下文模型，可按成本继续提高。
NOVELWB_EVENT_CONTEXT_TOKENS=120000

# 从仓库根目录启动时使用此路径；其他启动目录建议改为绝对路径。
NOVELWB_WORKSPACE=./server/workspace

# 适配器选择
# deepseek | mock；仅设置 mock 不代表具备所有阶段的可用样例。
# NOVELWB_LLM_ADAPTER 环境变量优先于此值；demo.py 会强制使用 mock。
LLM_ADAPTER=deepseek

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | text

# OFFLINE_MODE、SEARCH_ADAPTER、LLM_CACHE_ENABLED、LLM_CACHE_DIR 不由当前 API
# 配置入口读取，故不提供伪开关。离线演示由 demo.py 显式配置 mock 与隔离工作区。
