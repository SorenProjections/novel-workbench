# LLM
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_GRAPH2_TIMEOUT=300
DEEPSEEK_GRAPH2_RETRIES=1
DEEPSEEK_GRAPH3_TIMEOUT=600
DEEPSEEK_GRAPH3_RETRIES=1
DEEPSEEK_GRAPH4_PLAN_TIMEOUT=300
DEEPSEEK_GRAPH4_PLAN_RETRIES=1
DEEPSEEK_BLOCKS_TIMEOUT=180
DEEPSEEK_BLOCKS_RETRIES=1
# 事件上下文是确定性裁剪，不做模型摘要；适用于长上下文模型，可按成本继续提高。
NOVELWB_EVENT_CONTEXT_TOKENS=120000

# 工作区
WORKSPACE_ROOT=./workspace

# 适配器选择
LLM_ADAPTER=deepseek          # deepseek | mock_replay
SEARCH_ADAPTER=noop            # noop（RAG暂跳过）

# 缓存
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./cache/llm

# 离线模式（禁止联网，强制mock/cache）
OFFLINE_MODE=false

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=json               # json | text
